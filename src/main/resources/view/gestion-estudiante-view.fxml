<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="main.java.edu.ingsoft.colegio.gotitas.controller.EstudianteController">
    <stylesheets>
        <URL value="@/main/resources/css/styles.css" />
    </stylesheets>
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <AnchorPane prefHeight="60.0" prefWidth="600.0" styleClass="background" stylesheets="@../css/styles.css" BorderPane.alignment="CENTER">
               <children>
                  <AnchorPane prefHeight="62.0" prefWidth="621.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Label layoutX="14.0" layoutY="12.0" styleClass="label-primary" stylesheets="@../css/styles.css" text="Gestión de estudiantes" textFill="WHITE" />
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>
         </top>
         <left>
            <AnchorPane prefHeight="305.0" prefWidth="183.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox prefHeight="341.0" prefWidth="184.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="17.0" prefWidth="171.0" text="Datos del estudiante" />
                        <Label text="Ciudad" />
                        <ComboBox fx:id="cmbCiudad" prefHeight="25.0" prefWidth="186.0" promptText="Elija la ciudad" />
                        <Label prefHeight="17.0" prefWidth="178.0" text="Nombre" />
                        <TextField fx:id="txtFieldNombre" />
                        <Label prefHeight="17.0" prefWidth="206.0" text="Apellido" />
                        <TextField fx:id="txtFieldApellido" />
                        <Label prefHeight="17.0" prefWidth="185.0" text="Fecha de nacimiento" />
                        <DatePicker fx:id="dtpFechaNacimiento" />
                        <Label prefHeight="17.0" prefWidth="179.0" text="Correo electrónico" />
                        <TextField fx:id="txtFieldEmail" />
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="10.0" right="10.0" top="5.0" />
                     </padding>
                  </VBox>
               </children>
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </AnchorPane>
         </left>
         <center>
            <AnchorPane prefHeight="316.0" prefWidth="213.0" BorderPane.alignment="CENTER">
               <children>
                  <TableView fx:id="tvEstudiantes" prefHeight="338.0" prefWidth="186.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="13.0" AnchorPane.topAnchor="14.0">
                    <columns>
                      <TableColumn fx:id="tableColumnId" prefWidth="188.0" text="Estudiante ID" />
                      <TableColumn fx:id="tableColumnCiudad" minWidth="0.0" prefWidth="94.0" text="Ciudad" />
                        <TableColumn fx:id="tableColumnNombre" minWidth="1.0" prefWidth="112.0" text="Nombre" />
                        <TableColumn fx:id="tableColumnApellido" prefWidth="132.0" text="Apellido" />
                        <TableColumn fx:id="tableColumnFechaNacimiento" prefWidth="140.0" text="Fecha de nacimiento" />
                        <TableColumn fx:id="tableColumnEmail" prefWidth="317.0" text="Correo electrónico" />
                    </columns>
                  </TableView>
               </children>
            </AnchorPane>
         </center>
         <right>
            <AnchorPane prefHeight="340.0" prefWidth="164.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox prefHeight="340.0" prefWidth="175.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Button fx:id="btnCrear" mnemonicParsing="false" onAction="#createEstudiante" prefHeight="25.0" prefWidth="157.0" text="Crear" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#updateEstudiante" prefHeight="25.0" prefWidth="156.0" text="Actualizar" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#deleteEstudiante" prefHeight="25.0" prefWidth="155.0" text="Eliminar" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </AnchorPane>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
